# Copia este archivo a .env y cambia los valores. NUNCA subas .env al repo.
POSTGRES_USER=usuario_falso
POSTGRES_PASSWORD=contrasena_falsa_cambiar
POSTGRES_DB=loteria_dev
# "db" es el nombre del servicio en docker-compose.yml.
# "+psycopg2" fija el driver (SQLAlchemy 2.1 usa psycopg 3 por defecto).
DATABASE_URL=postgresql+psycopg2://usuario_falso:contrasena_falsa_cambiar@db:5432/loteria_dev
SECRET_KEY=clave-secreta-falsa-cambiar
# Puerto en tu máquina. En macOS el 5000 lo ocupa AirPlay Receiver: usa 5001.
APP_PORT=5000
